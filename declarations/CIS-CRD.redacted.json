        "class": "Endpoint_Policy",
        "rules": [
          {
            "name": "vs_cafe_example_com_coffee_coffee_svc_8080_cafe_cafe_example_com_coffee",
            "conditions": [
              {
                "type": "httpHeader",
                "name": "host",
                "event": "request",
                "all": {
                  "values": [
                    "cafe.example.com:80",
                    "cafe.example.com"
                  ],
                  "operand": "equals"
                }
              },
              {
                "type": "httpUri",
                "name": "1",
                "event": "request",
                "index": 1,
                "pathSegment": {
                  "values": [
                    "coffee"
                  ],
                  "operand": "equals"
                }
              }
            ],
            "actions": [
              {
                "type": "forward",
                "event": "request",
                "select": {
                  "pool": {
                    "use": "coffee_svc_8080_cafe_cafe_example_com_coffee"
                  }
                }
              }
            ]
          },
