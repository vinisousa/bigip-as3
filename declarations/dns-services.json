{
  "class": "AS3",
  "action": "deploy",
  "persist": true,
  "declaration": {
    "class": "ADC",
    "schemaVersion": "3.30.0",
    "id": "concavo_dns_services",
    "label": "DNS: concavo.local + example.com local, forward to 192.168.0.1",
    "remark": "BIG-IP authoritative locally for concavo.local and example.com via DNS Cache local zones, forwards all other (internet) queries to 192.168.0.1, served by a UDP/TCP listener on 192.168.100.32:53",
    "Sample_DNS_01": {
      "class": "Tenant",
      "DNS_App": {
        "class": "Application",
        "dns_forwarding_cache": {
          "class": "DNS_Cache",
          "type": "resolver",
          "label": "Local authoritative zones + forward to 192.168.0.1",
          "forwardZones": {
            ".": {
              "nameservers": [
                "192.168.0.1:53"
              ]
            }
          },
          "localZones": {
            "concavo.local": {
              "type": "static",
              "records": []
            },
            "example.com": {
              "type": "static",
              "records": [
                "cafe.example.com. 300 IN A 192.168.100.32"
              ]
            }
          }
        },
        "dns_profile": {
          "class": "DNS_Profile",
          "label": "Local authoritative zones + forwarding cache",
          "dnsExpressEnabled": false,
          "cacheEnabled": true,
          "cache": {
            "use": "dns_forwarding_cache"
          },
          "localBindServerEnabled": false
        },
        "dns_listener_udp": {
          "class": "Service_UDP",
          "label": "DNS listener UDP/53",
          "virtualAddresses": [
            "192.168.100.32"
          ],
          "virtualPort": 53,
          "profileUDP": {
            "bigip": "/Common/udp_gtm_dns"
          },
          "profileDNS": {
            "use": "dns_profile"
          }
        },
        "dns_listener_tcp": {
          "class": "Service_TCP",
          "label": "DNS listener TCP/53",
          "virtualAddresses": [
            "192.168.100.32"
          ],
          "virtualPort": 53,
          "profileTCP": {
            "bigip": "/Common/f5-tcp-progressive"
          },
          "profileDNS": {
            "use": "dns_profile"
          }
        }
      }
    }
  }
}
